# Install with
#   sudo cp etc/nginx/osm.freemap.sk /etc/nginx/sites-enabled/
#   sudo certbot --nginx -d osm.freemap.sk
# Certbot rewrites this file in place to add the TLS listeners.

server {
	listen 80;
	listen [::]:80;

	server_name osm.freemap.sk;

	access_log /var/log/nginx/access_osm.log;
	error_log /var/log/nginx/error_osm.log warn;

	# nginx.conf enables gzip but leaves gzip_types at the default (text/html
	# only). A screenful of POIs is 150-300 kB of JSON that gzips 5:1.
	gzip_types application/json;

	location / {
		limit_req zone=osm_req burst=40 nodelay;
		limit_req_status 429;

		# Deliberately uncached: the bbox differs on every pan, so a proxy cache
		# would collect single-use entries. Revisit if the endpoint ever rounds
		# bboxes to a tile grid, which is what would make responses shareable.
		proxy_pass http://127.0.0.1:3010;
		proxy_http_version 1.1;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;

		# A whole-country query for a rare category can take seconds; the app
		# gives up long before this.
		proxy_read_timeout 60s;
	}
}
