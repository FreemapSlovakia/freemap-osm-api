# The read-only OSM query API. Install with
#   sudo cp systemd/freemap-osm-api.service /etc/systemd/system/
# — see README "Deployment (fm5)".

[Unit]
Description=Freemap OSM query API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=freemap
WorkingDirectory=/opt/freemap-osm-api
# PGHOST and PGDATABASE, HTTP_PORT, CORS_ORIGINS.
EnvironmentFile=/etc/freemap-osm-api.conf
# The read-only role, which is this unit's own — the update unit shares the file
# but connects as the owner. See the comment there for why it is not in the file.
Environment=PGUSER=freemap
ExecStart=/home/freemap/.local/share/fnm/aliases/default/bin/node \
  --enable-source-maps build/index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
