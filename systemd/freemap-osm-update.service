# One replication catch-up. Driven by freemap-osm-update.timer; run it by hand
# (`systemctl start freemap-osm-update`) to see a single pass in the journal.
#
# The replication server and the flat-nodes file are remembered in
# osm2pgsql_properties from the import, so this repeats only the style — losing
# it would silently rebuild the table with a different shape. FM_REGION_QUERY
# comes from the environment file and must match the import: without it, the
# planet's diffs fill an extract database with a partial world map.

[Unit]
Description=Apply OSM replication diffs to the Freemap OSM database
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
# Owns the data; the API's user only reads.
User=osm
WorkingDirectory=/opt/freemap-osm-api
EnvironmentFile=/etc/freemap-osm-api.conf
# The shared file carries PGHOST, PGDATABASE and FM_REGION_QUERY but no PGUSER,
# because the two units connect as different roles: this one writes and owns the
# data, the API only reads. It has to be set here rather than in the file — an
# EnvironmentFile overrides Environment=, so a PGUSER in the file would win.
Environment=PGUSER=osm
# --max-diff-size caps one pass, so a long outage catches up over several runs
# instead of one that runs out of memory.
ExecStart=/usr/bin/osm2pgsql-replication update --max-diff-size 500 -- \
  --output=flex --style /opt/freemap-osm-api/osm2pgsql/freemap-osm.lua --slim
# A pass that dies mid-way leaves the database consistent (osm2pgsql is
# transactional), and the next tick picks up from the stored sequence.
TimeoutStartSec=6h
