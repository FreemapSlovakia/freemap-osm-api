# Database — the standard libpq variables.
PGHOST=localhost
PGPORT=5432
PGDATABASE=osm
PGUSER=osm
PGPASSWORD=

HTTP_HOST=127.0.0.1
HTTP_PORT=3000
LOG_LEVEL=debug

# Empty means no CORS headers at all.
CORS_ORIGINS=https://www.freemap.sk,https://freemap.sk,http://localhost:8080

# Serves the OpenAPI document and the Scalar reference at /docs.
DOCS=true
