{
  "name": "freemap-osm-api",
  "version": "1.0.0",
  "private": true,
  "description": "Read-only OSM query API for Freemap, backed by an osm2pgsql database",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "author": {
    "name": "Freemap Slovakia",
    "email": "freemap@freemap.sk"
  },
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc",
    "start": "node --enable-source-maps build/index.js",
    "dev": "tsc-watch --onSuccess \"pnpm run dev:serve\"",
    "dev:serve": "dotenvx run --overload -- sh -c 'node --enable-source-maps build/index.js | pino-pretty -S -t -i hostname,pid'",
    "lint": "biome check --error-on-warnings",
    "lint:fix": "biome check --write --error-on-warnings"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.8.1",
    "@scalar/fastify-api-reference": "^1.67.0",
    "fastify": "^5.12.1",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@dotenvx/dotenvx": "^2.23.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.1.3",
    "tsc-watch": "^7.2.1",
    "typescript": "~7.0.2"
  }
}
